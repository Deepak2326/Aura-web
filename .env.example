# --- Core ---
ENVIRONMENT=development
# PostgreSQL example: postgresql+psycopg2://aura:aura@localhost:5432/aura
DATABASE_URL=sqlite:///./aura_leads.db
DB_AUTO_CREATE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth / Admin ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe!123

# --- Abuse protection ---
RATE_LIMIT_SUBMIT_MAX=5
RATE_LIMIT_SUBMIT_WINDOW=600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=600
DUPLICATE_WINDOW_HOURS=24

# --- CRM integration ---
# Providers: aura_crm (your existing AURA CRM) | mock | generic_rest | none
CRM_PROVIDER=mock
CRM_MOCK_BEHAVIOR=success
CRM_API_URL=
CRM_API_KEY=
CRM_TIMEOUT_SECONDS=10
CRM_RESPONSE_ID_PATH=id
CRM_MAX_ATTEMPTS=3
CRM_RETRY_BACKOFF_SECONDS=1
# Optional JSON object overriding the default field mapping: {"CrmField": "lead_field"}
CRM_FIELD_MAPPING=

# --- AURA Self-Evolving CRM (your existing CRM) ---
# Set CRM_PROVIDER=aura_crm and fill these from the captured create-record
# request (F12 → Network → Copy as cURL). See docs/CRM_MAPPING_WORKSHEET.md.
# CRM_PROVIDER=aura_crm
AURA_CRM_API_URL=
AURA_CRM_API_KEY=
AURA_CRM_AUTH_HEADER=Authorization
AURA_CRM_AUTH_SCHEME=Bearer
# Optional JSON merged into every create request, e.g.
# {"workspace": "Analytical_E_Commerce_CRM", "entity": "machine_identifier"}
AURA_CRM_EXTRA_PAYLOAD=
